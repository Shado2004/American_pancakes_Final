# ==============================================================================
# American Pancakes POS — Environment Variables Configuration
# Copy this file to .env and fill in your real credentials (never commit .env)
# ==============================================================================

# ── Backend / Database (Render & Express API) ─────────────────────────────────
# Port for the Express server (Render sets PORT=10000 automatically)
PORT=10000

# Node environment mode
NODE_ENV=production

# Supabase Session Pooler connection string (Port 5432, session mode)
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Postgres connection pool limit (recommended: 5 for Supabase free-tier)
PGPOOL_MAX=5
PGSSL=true
PGAPPNAME=american-pancakes-pos

# Secret keys for signing authentication tokens & sessions
JWT_SECRET=generate_a_random_32_character_secret_here
SESSION_SECRET=generate_another_random_secret_here

# Allowed frontend origin (use '*' during initial setup or your Vercel URL)
APP_ORIGIN=*

# ── Frontend (Vercel & Next.js) ──────────────────────────────────────────────
# URL pointing to your deployed Render API (without trailing slash)
NEXT_PUBLIC_API_URL=https://american-pancakes-api.onrender.com

# Public web host URL
NEXT_PUBLIC_WEB_HOST=https://american-pancakes-pos.vercel.app
