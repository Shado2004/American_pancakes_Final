{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ES2022"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "strict": false,
    "rootDir": "..",
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": ["../tests/**/*", "../main/**/*", "../shared/**/*"]
}
